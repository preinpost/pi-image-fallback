{
  "name": "pi-image-fallback",
  "version": "1.0.0",
  "description": "pi extension: let a text-only model see pasted images through a vision sidecar, without ever switching models.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "image",
    "vision",
    "model-routing",
    "multimodal",
    "sidecar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preinpost/pi-image-fallback.git"
  },
  "homepage": "https://github.com/preinpost/pi-image-fallback#readme",
  "bugs": {
    "url": "https://github.com/preinpost/pi-image-fallback/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit"
  }
}
